@model EduDocFlow.Web.ViewModels.StudentDashboardViewModel
@using EduDocFlow.Web.Models

@{
    ViewData["Title"] = "Кабинет студента";
}

<div class="container mt-4 mb-5">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success mb-4" role="alert">
            @TempData["SuccessMessage"]
        </div>
    }

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-start gap-3 mb-4">
        <div>
            <h1 class="mb-2">Кабинет студента</h1>
            <p class="text-muted mb-0">
                Здесь можно подать заявку на справку или заявление и отследить ход обработки документа.
            </p>
        </div>

        <a class="btn btn-primary" asp-controller="Student" asp-action="Create">
            Новая заявка
        </a>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-lg-4">
            <div class="card h-100">
                <div class="card-header fw-semibold">
                    Данные студента
                </div>

                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-5">ФИО</dt>
                        <dd class="col-sm-7">@Model.FullName</dd>

                        <dt class="col-sm-5">Электронная почта</dt>
                        <dd class="col-sm-7">@Model.Email</dd>

                        @if (Model.Profile != null)
                        {
                            <dt class="col-sm-5">Группа</dt>
                            <dd class="col-sm-7">@Model.Profile.GroupName</dd>

                            <dt class="col-sm-5">Курс</dt>
                            <dd class="col-sm-7">@Model.Profile.Course</dd>

                            <dt class="col-sm-5">Программа</dt>
                            <dd class="col-sm-7">@Model.Profile.EducationProgram</dd>

                            <dt class="col-sm-5">Форма обучения</dt>
                            <dd class="col-sm-7">@Model.Profile.StudyForm</dd>

                            <dt class="col-sm-5">Дата зачисления</dt>
                            <dd class="col-sm-7">@Model.Profile.EnrollmentDate.ToString("dd.MM.yyyy")</dd>

                            <dt class="col-sm-5">Статус</dt>
                            <dd class="col-sm-7 mb-0">@Model.Profile.StudentStatus</dd>
                        }
                        else
                        {
                            <dd class="col-12 mb-0">
                                <div class="alert alert-warning mb-0" role="alert">
                                    Профиль студента не заполнен. Для подачи заявок обратитесь в учебную часть.
                                </div>
                            </dd>
                        }
                    </dl>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
           <div class="row row-cols-2 row-cols-md-5 g-3 mb-3">
    <div class="col">
        <div class="card text-center h-100">
            <div class="card-body">
                <div class="fs-2 fw-bold">@Model.TotalRequests</div>
                <div class="text-muted">Всего заявок</div>
            </div>
        </div>
    </div>

    <div class="col">
        <div class="card text-center h-100">
            <div class="card-body">
                <div class="fs-2 fw-bold">@Model.CreatedRequests</div>
                <div class="text-muted">Созданы</div>
            </div>
        </div>
    </div>

    <div class="col">
        <div class="card text-center h-100">
            <div class="card-body">
                <div class="fs-2 fw-bold">@Model.InProgressRequests</div>
                <div class="text-muted">В работе</div>
            </div>
        </div>
    </div>

    <div class="col">
        <div class="card text-center h-100">
            <div class="card-body">
                <div class="fs-2 fw-bold">@Model.CompletedRequests</div>
                <div class="text-muted">Готовы</div>
            </div>
        </div>
    </div>

    <div class="col">
        <div class="card text-center h-100">
            <div class="card-body">
                <div class="fs-2 fw-bold">@Model.RejectedRequests</div>
                <div class="text-muted">Отклонены</div>
            </div>
        </div>
    </div>
</div>
            </div>

            <div class="card">
                <div class="card-header fw-semibold d-flex justify-content-between align-items-center">
                    <span>Последние заявки</span>
                    <span class="text-muted small">Последние созданные обращения</span>
                </div>

                <div class="card-body">
                    @if (Model.RecentRequests.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Номер</th>
                                        <th>Документ</th>
                                        <th>Статус</th>
                                        <th>Дата создания</th>
                                        <th>Плановый срок</th>
                                        <th class="text-end">Действия</th>
                                    </tr>   
                                </thead>
                                <tbody>
                                    @foreach (var request in Model.RecentRequests)
                                    {
                                        <tr>
                                            <td class="text-nowrap">@request.Number</td>
                                            <td>@(request.DocumentType?.Name ?? "Документ не указан")</td>
                                            <td>
                                                <span class="badge @GetStatusCss(request.Status)">
                                                    @GetStatusName(request.Status)
                                                </span>
                                            </td>
                                            <td class="text-nowrap">@request.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                            <td class="text-nowrap">
                                                @(request.DueDate.HasValue ? request.DueDate.Value.ToString("dd.MM.yyyy") : "Не установлен")
                                            </td>
                                            <td class="text-end">
                                                <a asp-controller="Student"
                                                   asp-action="Details"
                                                   asp-route-id="@request.Id"
                                                   class="btn btn-sm btn-outline-primary">
                                                    Открыть
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-muted">
                            <p class="mb-2">У вас пока нет заявок.</p>
                            <p class="mb-0">
                                Нажмите кнопку «Новая заявка», выберите тип документа и заполните необходимые поля.
                            </p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@functions {
   private static string GetStatusName(DocumentStatus status)
{
    return status switch
    {
        DocumentStatus.Created => "Создана",
        DocumentStatus.OnMethodistReview => "В работе у учебной части",
        DocumentStatus.Completed => "Готова",
        DocumentStatus.Rejected => "Отклонена",
        _ => "Неизвестный статус"
    };
}

    private static string GetStatusCss(DocumentStatus status)
{
    return status switch
    {
        DocumentStatus.Created => "text-bg-secondary",
        DocumentStatus.OnMethodistReview => "text-bg-warning",
        DocumentStatus.Completed => "text-bg-success",
        DocumentStatus.Rejected => "text-bg-danger",
        _ => "text-bg-secondary"
    };
}
    }
}
