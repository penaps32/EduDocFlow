@model EduDocFlow.Web.Models.DocumentRequest
@using EduDocFlow.Web.Models

@{
    ViewData["Title"] = "Просмотр заявки";

    string StatusName(DocumentStatus status)
    {
        return status switch
        {
            DocumentStatus.Created => "Создана",
            DocumentStatus.OnMethodistReview => "В работе у учебной части",
            DocumentStatus.Completed => "Готова",
            DocumentStatus.Rejected => "Отклонена",
            _ => "Неизвестный статус"
        };
    }

    string StatusBadgeClass(DocumentStatus status)
    {
        return status switch
        {
            DocumentStatus.Created => "edu-status edu-status-created",
            DocumentStatus.OnMethodistReview => "edu-status edu-status-progress",
            DocumentStatus.Completed => "edu-status edu-status-done",
            DocumentStatus.Rejected => "edu-status edu-status-rejected",
            _ => "edu-status edu-status-muted"
        };
    }

    string StatusText(DocumentStatus status)
    {
        return status switch
        {
            DocumentStatus.Created => "Заявка создана и ожидает проверки сотрудником учебной части.",
            DocumentStatus.OnMethodistReview => "Заявка принята в работу учебной частью.",
            DocumentStatus.Completed => "Документ готов. Обратитесь в учебную часть для получения.",
            DocumentStatus.Rejected => "Заявка отклонена. Причину можно посмотреть в комментариях или истории обработки.",
            _ => "Статус заявки не определен."
        };
    }

    string EmptyText(string? value, string emptyText = "Не указано")
    {
        return string.IsNullOrWhiteSpace(value) ? emptyText : value;
    }

    var comments = Model.Comments?.OrderByDescending(x => x.CreatedAt).ToList() ?? new();
    var history = Model.StatusHistoryItems?.OrderByDescending(x => x.ChangedAt).ToList() ?? new();
}

<div class="edu-page student-page">
    <div class="edu-page-head">
        <div>
            <div class="edu-eyebrow">Кабинет студента</div>
            <h1 class="edu-page-title">Заявка @Model.Number</h1>
            <p class="edu-page-subtitle">
                Подробная информация по вашей заявке и история ее обработки.
            </p>
        </div>

        <a asp-controller="Student"
           asp-action="Index"
           class="edu-btn edu-btn-outline">
            Назад в кабинет
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success edu-alert">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger edu-alert">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="student-details-layout">
        <main class="student-details-main">
            <section class="edu-card mb-4">
                <div class="edu-card-head student-status-head">
                    <div>
                        <h2 class="edu-card-title">Данные заявки</h2>
                        <p class="edu-card-subtitle">Основные сведения, указанные при создании заявки.</p>
                    </div>
                    <span class="@StatusBadgeClass(Model.Status)">@StatusName(Model.Status)</span>
                </div>

                <div class="edu-card-body">
                    <dl class="edu-info-grid">
                        <dt>Номер заявки</dt>
                        <dd>@Model.Number</dd>

                        <dt>Тип документа</dt>
                        <dd>@(Model.DocumentType?.Name ?? "Документ не указан")</dd>

                        <dt>Дата создания</dt>
                        <dd>@Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</dd>

                        <dt>Дата обновления</dt>
                        <dd>
                            @(Model.UpdatedAt.HasValue
                                ? Model.UpdatedAt.Value.ToString("dd.MM.yyyy HH:mm")
                                : "Не обновлялась")
                        </dd>

                        <dt>Плановый срок</dt>
                        <dd>
                            @(Model.DueDate.HasValue
                                ? Model.DueDate.Value.ToString("dd.MM.yyyy")
                                : "Не установлен")
                        </dd>

                        <dt>Ответственный сотрудник</dt>
                        <dd>@(Model.AssignedEmployee?.FullName ?? "Пока не назначен")</dd>

                        <dt>Получатель документа</dt>
                        <dd>@EmptyText(Model.RecipientOrganization)</dd>

                        <dt>Место предоставления</dt>
                        <dd>@EmptyText(Model.DestinationPlace)</dd>

                        <dt>Цель получения</dt>
                        <dd>@EmptyText(Model.Purpose)</dd>

                        <dt>Место работы</dt>
                        <dd>@EmptyText(Model.Workplace)</dd>

                        <dt>Комментарий студента</dt>
                        <dd>@EmptyText(Model.StudentComment, "Комментарий не указан")</dd>
                    </dl>
                </div>
            </section>

            <section class="edu-card mb-4">
                <div class="edu-card-head">
                    <h2 class="edu-card-title">Период обучения</h2>
                </div>

                <div class="edu-card-body">
                    <dl class="edu-info-grid edu-info-grid-small mb-0">
                        <dt>Начало периода</dt>
                        <dd>
                            @(Model.StudyPeriodStart.HasValue
                                ? Model.StudyPeriodStart.Value.ToString("dd.MM.yyyy")
                                : "Не указано")
                        </dd>

                        <dt>Окончание периода</dt>
                        <dd>
                            @(Model.StudyPeriodEnd.HasValue
                                ? Model.StudyPeriodEnd.Value.ToString("dd.MM.yyyy")
                                : "Не указано")
                        </dd>
                    </dl>
                </div>
            </section>

            <section class="edu-card">
                <div class="edu-card-head">
                    <div>
                        <h2 class="edu-card-title">История обработки</h2>
                        <p class="edu-card-subtitle">Все изменения статуса заявки сохраняются в журнале.</p>
                    </div>
                </div>

                <div class="edu-card-body p-0">
                    @if (history.Any())
                    {
                        <div class="table-responsive">
                            <table class="table edu-table mb-0">
                                <thead>
                                    <tr>
                                        <th>Дата</th>
                                        <th>Статус</th>
                                        <th>Пользователь</th>
                                        <th>Комментарий</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in history)
                                    {
                                        <tr>
                                            <td class="text-nowrap">@item.ChangedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                            <td>
                                                <span class="@StatusBadgeClass(item.NewStatus)">
                                                    @StatusName(item.NewStatus)
                                                </span>
                                            </td>
                                            <td>@(item.ChangedByUser?.FullName ?? "Пользователь не указан")</td>
                                            <td>@EmptyText(item.Comment, "Без комментария")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="edu-empty">
                            <div class="edu-empty-title">История пока отсутствует</div>
                            <div class="edu-empty-text">Записи появятся после изменения статуса заявки.</div>
                        </div>
                    }
                </div>
            </section>
        </main>

        <aside class="student-details-side">
            <section class="edu-card mb-4">
                <div class="edu-card-head">
                    <h2 class="edu-card-title">Текущий статус</h2>
                </div>

                <div class="edu-card-body">
                    <div class="mb-3">
                        <span class="@StatusBadgeClass(Model.Status)">@StatusName(Model.Status)</span>
                    </div>

                    <p class="student-help-text mb-0">
                        @StatusText(Model.Status)
                    </p>
                </div>
            </section>

            <section class="edu-card mb-4">
                <div class="edu-card-head">
                    <h2 class="edu-card-title">Добавить уточнение</h2>
                </div>

                <div class="edu-card-body">
                    @if (Model.Status == DocumentStatus.Completed || Model.Status == DocumentStatus.Rejected)
                    {
                        <div class="student-help-text">
                            Заявка завершена. Новые уточнения по ней недоступны.
                        </div>
                    }
                    else
                    {
                        <form asp-controller="Student" asp-action="AddComment" method="post">
                            @Html.AntiForgeryToken()

                            <input type="hidden" name="requestId" value="@Model.Id" />

                            <div class="edu-field mb-3">
                                <label class="edu-label">Текст уточнения</label>
                                <textarea name="text"
                                          class="form-control edu-control"
                                          rows="4"
                                          placeholder="Например: уточняю место предоставления справки"></textarea>
                            </div>

                            <button type="submit" class="edu-btn edu-btn-primary w-100">
                                Отправить уточнение
                            </button>
                        </form>
                    }
                </div>
            </section>

            <section class="edu-card">
                <div class="edu-card-head">
                    <div>
                        <h2 class="edu-card-title">Переписка</h2>
                        <p class="edu-card-subtitle">Комментарии студента и учебной части.</p>
                    </div>
                </div>

                <div class="edu-card-body">
                    @if (comments.Any())
                    {
                        @foreach (var comment in comments)
                        {
                            var isStudentComment = comment.AuthorId == Model.StudentId;

                            <div class="edu-message">
                                <div class="edu-message-top">
                                    <div class="edu-message-author">
                                        @(comment.Author?.FullName ?? "Пользователь не указан")
                                    </div>
                                    <div class="edu-message-date">
                                        @comment.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                                    </div>
                                </div>

                                <div class="edu-message-role">
                                    @(isStudentComment ? "Студент" : "Сотрудник учебной части")
                                </div>

                                <div class="edu-message-text">
                                    @comment.Text
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="student-help-text">Комментариев пока нет.</div>
                    }
                </div>
            </section>
        </aside>
    </div>
</div>
