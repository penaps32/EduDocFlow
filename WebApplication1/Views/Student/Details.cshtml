@model EduDocFlow.Web.Models.DocumentRequest
@using EduDocFlow.Web.Models

@{
    ViewData["Title"] = "Просмотр заявки";

    string StatusName(DocumentStatus status)
    {
        return status switch
        {
            DocumentStatus.Created => "Создана",
            DocumentStatus.OnMethodistReview => "В работе у учебной части",
            DocumentStatus.Completed => "Готова",
            DocumentStatus.Rejected => "Отклонена",
            _ => "Неизвестный статус"
        };
    }

    string StatusBadgeClass(DocumentStatus status)
    {
        return status switch
        {
            DocumentStatus.Created => "bg-secondary-lt text-secondary",
            DocumentStatus.OnMethodistReview => "bg-yellow-lt text-yellow",
            DocumentStatus.Completed => "bg-green-lt text-green",
            DocumentStatus.Rejected => "bg-red-lt text-red",
            _ => "bg-secondary-lt text-secondary"
        };
    }

    string StatusText(DocumentStatus status)
    {
        return status switch
        {
            DocumentStatus.Created => "Заявка создана и ожидает проверки сотрудником учебной части.",
            DocumentStatus.OnMethodistReview => "Заявка принята в работу учебной частью.",
            DocumentStatus.Completed => "Документ готов. Обратитесь в учебную часть для получения.",
            DocumentStatus.Rejected => "Заявка отклонена. Причину можно посмотреть в комментариях или истории обработки.",
            _ => "Статус заявки не определен."
        };
    }

    string EmptyText(string? value, string emptyText = "Не указано")
    {
        return string.IsNullOrWhiteSpace(value) ? emptyText : value;
    }

    var comments = Model.Comments?.OrderByDescending(x => x.CreatedAt).ToList() ?? new();
    var history = Model.StatusHistoryItems?.OrderByDescending(x => x.ChangedAt).ToList() ?? new();
}

<div class="container-xl">
    <div class="page-header d-print-none mb-4">
        <div class="row align-items-center">
            <div class="col">
                <div class="page-pretitle">
                    Кабинет студента
                </div>
                <h1 class="page-title">
                    Заявка @Model.Number
                </h1>
                <div class="text-secondary mt-2">
                    Подробная информация по вашей заявке и история ее обработки.
                </div>
            </div>

            <div class="col-auto">
                <a asp-controller="Student"
                       asp-action="Index"
                       class="btn btn-outline-secondary">
                    Назад в кабинет
                </a>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card border-0 mb-4">
                <div class="card-header">
                    <div>
                        <h3 class="card-title mb-1">
                            Данные заявки
                        </h3>
                        <div class="text-secondary">
                            Основные сведения, указанные при создании заявки.
                        </div>
                    </div>
                </div>

                <div class="card-body">
                    <dl class="edf-info-list">
                        <dt>Номер заявки</dt>
                        <dd>@Model.Number</dd>

                        <dt>Тип документа</dt>
                        <dd>@(Model.DocumentType?.Name ?? "Документ не указан")</dd>

                        <dt>Статус</dt>
                        <dd>
                            <span class="badge @StatusBadgeClass(Model.Status)">
                                @StatusName(Model.Status)
                            </span>
                        </dd>

                        <dt>Дата создания</dt>
                        <dd>@Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</dd>

                        <dt>Дата обновления</dt>
                        <dd>
                            @(Model.UpdatedAt.HasValue
                                ? Model.UpdatedAt.Value.ToString("dd.MM.yyyy HH:mm")
                                : "Не обновлялась")
                        </dd>

                        <dt>Плановый срок</dt>
                        <dd>
                            @(Model.DueDate.HasValue
                                ? Model.DueDate.Value.ToString("dd.MM.yyyy")
                                : "Не установлен")
                        </dd>

                        <dt>Ответственный сотрудник</dt>
                        <dd>@(Model.AssignedEmployee?.FullName ?? "Пока не назначен")</dd>

                        <dt>Получатель документа</dt>
                        <dd>@EmptyText(Model.RecipientOrganization)</dd>

                        <dt>Место предоставления</dt>
                        <dd>@EmptyText(Model.DestinationPlace)</dd>

                        <dt>Цель получения</dt>
                        <dd>@EmptyText(Model.Purpose)</dd>

                        <dt>Место работы</dt>
                        <dd>@EmptyText(Model.Workplace)</dd>

                        <dt>Комментарий студента</dt>
                        <dd>@EmptyText(Model.StudentComment, "Комментарий не указан")</dd>
                    </dl>
                </div>
            </div>

            <div class="card border-0 mb-4">
                <div class="card-header">
                    <h3 class="card-title mb-0">
                        Период обучения
                    </h3>
                </div>

                <div class="card-body">
                    <dl class="edf-info-list mb-0">
                        <dt>Начало периода</dt>
                        <dd>
                            @(Model.StudyPeriodStart.HasValue
                                ? Model.StudyPeriodStart.Value.ToString("dd.MM.yyyy")
                                : "Не указано")
                        </dd>

                        <dt>Окончание периода</dt>
                        <dd>
                            @(Model.StudyPeriodEnd.HasValue
                                ? Model.StudyPeriodEnd.Value.ToString("dd.MM.yyyy")
                                : "Не указано")
                        </dd>
                    </dl>
                </div>
            </div>

            <div class="card border-0">
                <div class="card-header">
                    <div>
                        <h3 class="card-title mb-1">
                            История обработки
                        </h3>
                        <div class="text-secondary">
                            Все изменения статуса заявки сохраняются в журнале.
                        </div>
                    </div>
                </div>

                <div class="card-body">
                    @if (history.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-vcenter">
                                <thead>
                                    <tr>
                                        <th>Дата</th>
                                        <th>Статус</th>
                                        <th>Пользователь</th>
                                        <th>Комментарий</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in history)
                                    {
                                        <tr>
                                            <td class="text-nowrap">@item.ChangedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                            <td>
                                                <span class="badge @StatusBadgeClass(item.NewStatus)">
                                                    @StatusName(item.NewStatus)
                                                </span>
                                            </td>
                                            <td>@(item.ChangedByUser?.FullName ?? "Пользователь не указан")</td>
                                            <td>@EmptyText(item.Comment, "Без комментария")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="empty">
                            <div class="empty-title">
                                История пока отсутствует
                            </div>
                            <p class="empty-subtitle text-secondary">
                                Записи появятся после изменения статуса заявки.
                            </p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 mb-4">
                <div class="card-header">
                    <h3 class="card-title mb-0">
                        Текущий статус
                    </h3>
                </div>

                <div class="card-body">
                    <div class="mb-3">
                        <span class="badge @StatusBadgeClass(Model.Status)">
                            @StatusName(Model.Status)
                        </span>
                    </div>

                    <p class="text-secondary mb-0">
                        @StatusText(Model.Status)
                    </p>
                </div>
            </div>

            <div class="card border-0 mb-4">
                <div class="card-header">
                    <h3 class="card-title mb-0">
                        Добавить уточнение
                    </h3>
                </div>

                <div class="card-body">
                    @if (Model.Status == DocumentStatus.Completed || Model.Status == DocumentStatus.Rejected)
                    {
                        <div class="text-secondary">
                            Заявка завершена. Новые уточнения по ней недоступны.
                        </div>
                    }
                    else
                    {
                        <form asp-controller="Student" asp-action="AddComment" method="post">
                            @Html.AntiForgeryToken()

                            <input type="hidden" name="requestId" value="@Model.Id" />

                            <div class="mb-3">
                                <label class="form-label">
                                    Текст уточнения
                                </label>
                                <textarea name="text"
                                          class="form-control"
                                          rows="4"
                                          placeholder="Например: уточняю место предоставления справки или добавляю сведения по запросу учебной части"></textarea>
                            </div>

                            <button type="submit" class="btn btn-primary w-100">
                                Отправить уточнение
                            </button>
                        </form>
                    }
                </div>
            </div>

            <div class="card border-0">
                <div class="card-header">
                    <div>
                        <h3 class="card-title mb-1">
                            Переписка по заявке
                        </h3>
                        <div class="text-secondary">
                            Комментарии студента и учебной части.
                        </div>
                    </div>
                </div>

                <div class="card-body">
                    @if (comments.Any())
                    {
                        @foreach (var comment in comments)
                        {
                            var isStudentComment = comment.AuthorId == Model.StudentId;

                            <div class="edf-message">
                                <div class="d-flex justify-content-between gap-3 mb-1">
                                    <div class="fw-semibold">
                                        @(comment.Author?.FullName ?? "Пользователь не указан")
                                    </div>
                                    <div class="text-secondary small text-nowrap">
                                        @comment.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                                    </div>
                                </div>

                                <div class="text-secondary small mb-2">
                                    @(isStudentComment ? "Студент" : "Сотрудник учебной части")
                                </div>

                                <div>
                                    @comment.Text
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-secondary">
                            Комментариев пока нет.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>