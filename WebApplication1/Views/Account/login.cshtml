@model EduDocFlow.Web.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Вход в систему";
}

<div class="auth-page auth-page-clean">
    <div class="auth-shell">
        <div class="auth-card">
            <div class="auth-card-header">
                <div>
                    <div class="auth-kicker">Информационная система</div>
                    <h1 class="auth-title">Учебный документооборот</h1>
                    <p class="auth-subtitle">Войдите под своей учетной записью, чтобы продолжить работу с заявками и документами.</p>
                </div>
            </div>

            <form asp-action="Login" method="post" class="auth-form">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="form-field">
                    <label asp-for="Email" class="form-label">Электронная почта</label>
                    <input asp-for="Email" class="form-control auth-input" placeholder="Введите электронную почту" autocomplete="username" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="form-field">
                    <label asp-for="Password" class="form-label">Пароль</label>
                    <input asp-for="Password" class="form-control auth-input" placeholder="Введите пароль" autocomplete="current-password" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="auth-options">
                    <div class="form-check mb-0">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label">Запомнить меня</label>
                    </div>
                </div>

                <button type="submit" class="btn auth-submit w-100">
                    Войти
                </button>
            </form>
        </div>

        <div class="auth-info-card">
            <div class="auth-info-title">Доступные разделы</div>
            <div class="auth-info-item">
                <div class="auth-info-number">01</div>
                <div>
                    <div class="auth-info-name">Кабинет студента</div>
                    <div class="auth-info-text">Подача заявок, просмотр статусов и получение готовых документов.</div>
                </div>
            </div>
            <div class="auth-info-item">
                <div class="auth-info-number">02</div>
                <div>
                    <div class="auth-info-name">Кабинет сотрудника</div>
                    <div class="auth-info-text">Проверка заявок, изменение статусов и подготовка документов.</div>
                </div>
            </div>
            <div class="auth-info-item">
                <div class="auth-info-number">03</div>
                <div>
                    <div class="auth-info-name">Панель администратора</div>
                    <div class="auth-info-text">Управление пользователями, типами документов и настройками системы.</div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
