@{
    ViewData["Title"] = "Главная";
    ViewData["HideUserPanel"] = true;
}

<div class="edu-home">
    <section class="edu-home-hero">
        <div class="edu-home-hero__content">
            <div class="edu-home-kicker">Информационная система учебного заведения</div>

            <h1 class="edu-home-title">
                Учебный документооборот без лишней бумажной нагрузки
            </h1>

            <p class="edu-home-text">
                Студенты подают заявки на справки и заявления онлайн, сотрудники учебной части
                обрабатывают обращения, меняют статусы и формируют готовые документы в одной системе.
            </p>

            <div class="edu-home-actions">
                <a asp-controller="Account" asp-action="Login" class="edu-home-btn edu-home-btn-primary">
                    Войти
                </a>
            </div>
        </div>

        <div class="edu-home-panel">
            <div class="edu-home-panel__header">
                Возможности системы
            </div>

            <div class="edu-home-feature">
                <div class="edu-home-feature__num">01</div>
                <div>
                    <div class="edu-home-feature__title">Кабинет студента</div>
                    <div class="edu-home-feature__text">
                        Подача заявок, просмотр статусов, добавление уточнений и получение готовых документов.
                    </div>
                </div>
            </div>

            <div class="edu-home-feature">
                <div class="edu-home-feature__num">02</div>
                <div>
                    <div class="edu-home-feature__title">Кабинет сотрудника</div>
                    <div class="edu-home-feature__text">
                        Проверка заявок, комментарии, изменение статусов и подготовка учебных документов.
                    </div>
                </div>
            </div>

            <div class="edu-home-feature mb-0">
                <div class="edu-home-feature__num">03</div>
                <div>
                    <div class="edu-home-feature__title">Панель администратора</div>
                    <div class="edu-home-feature__text">
                        Управление пользователями, типами документов и основными данными системы.
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="edu-home-cards">
        <div class="edu-home-card">
            <div class="edu-home-card__label">Для студентов</div>
            <div class="edu-home-card__title">Заявки онлайн</div>
            <div class="edu-home-card__text">
                Обращение создается через личный кабинет, а его текущий статус всегда отображается в списке заявок.
            </div>
        </div>

        <div class="edu-home-card">
            <div class="edu-home-card__label">Для учебной части</div>
            <div class="edu-home-card__title">Единая обработка</div>
            <div class="edu-home-card__text">
                Все действия по заявке сохраняются в истории: статус, комментарий, дата и ответственный сотрудник.
            </div>
        </div>

        <div class="edu-home-card">
            <div class="edu-home-card__label">Для администрации</div>
            <div class="edu-home-card__title">Контроль данных</div>
            <div class="edu-home-card__text">
                Администратор управляет учетными записями, ролями и перечнем доступных типов документов.
            </div>
        </div>
    </section>
</div>
