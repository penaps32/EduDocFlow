@model EduDocFlow.Web.ViewModels.MethodistDashboardViewModel
@using EduDocFlow.Web.Models

@{
    ViewData["Title"] = "Кабинет сотрудника";
}

@functions {
    private string StatusText(DocumentStatus status)
    {
        return status switch
        {
            DocumentStatus.Created => "Создана",
            DocumentStatus.OnMethodistReview => "В работе",
            DocumentStatus.Completed => "Готова",
            DocumentStatus.Rejected => "Отклонена",
            _ => "Неизвестно"
        };
    }

    private string StatusClass(DocumentStatus status)
    {
        return status switch
        {
            DocumentStatus.Created => "status-created",
            DocumentStatus.OnMethodistReview => "status-progress",
            DocumentStatus.Completed => "status-completed",
            DocumentStatus.Rejected => "status-rejected",
            _ => "status-muted"
        };
    }

    private string DateText(object? value)
    {
        if (value is DateTime date)
        {
            return date.ToString("dd.MM.yyyy HH:mm");
        }

        return "Не указан";
    }

    private string DateOnlyText(object? value)
    {
        if (value is DateTime date)
        {
            return date.ToString("dd.MM.yyyy");
        }

        return "Не указан";
    }
}

<div class="office-page">
    <section class="office-hero">
        <div>
            <div class="office-kicker">Кабинет сотрудника</div>
            <h1 class="office-title">Обработка заявок</h1>
            <p class="office-lead">
                Здесь отображаются обращения студентов, которые нужно проверить, обработать и подготовить к выдаче.
            </p>
        </div>
    </section>

    <section class="office-stats">
        <div class="office-stat-card">
            <div class="office-stat-label">Всего заявок</div>
            <div class="office-stat-value">@Model.TotalRequests</div>
        </div>

        <div class="office-stat-card">
            <div class="office-stat-label">Созданы</div>
            <div class="office-stat-value">@Model.CreatedRequests</div>
        </div>

        <div class="office-stat-card">
            <div class="office-stat-label">В работе</div>
            <div class="office-stat-value">@Model.InProgressRequests</div>
        </div>

        <div class="office-stat-card">
            <div class="office-stat-label">Готовы</div>
            <div class="office-stat-value">@Model.CompletedRequests</div>
        </div>
    </section>

    <section class="office-card">
        <div class="office-card-head">
            <div>
                <h2>Последние заявки</h2>
                <p>Список обращений, требующих обработки сотрудником.</p>
            </div>
        </div>

        @if (Model.Requests == null || !Model.Requests.Any())
        {
            <div class="office-empty">
                Сейчас нет заявок для обработки.
            </div>
        }
        else
        {
            <div class="office-table-wrap">
                <table class="office-table">
                    <thead>
                        <tr>
                            <th>Номер</th>
                            <th>Студент</th>
                            <th>Документ</th>
                            <th>Статус</th>
                            <th>Создана</th>
                            <th>Срок</th>
                            <th class="office-actions-col">Действия</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var request in Model.Requests)
                        {
                            <tr>
                                <td>
                                    <div class="office-main-text">@request.Number</div>
                                </td>

                                <td>
                                    <div class="office-main-text">@request.StudentFullName</div>
                                    <div class="office-sub-text">@request.StudentGroup</div>
                                </td>

                                <td>
                                    <div class="office-main-text">@request.DocumentTypeName</div>
                                </td>

                                <td>
                                    <span class="office-status @StatusClass(request.Status)">
                                        @StatusText(request.Status)
                                    </span>
                                </td>

                                <td>
                                    @DateText(request.CreatedAt)
                                </td>

                                <td>
                                    @DateOnlyText(request.DueDate)
                                </td>

                                <td class="office-actions-col">
                                    <a asp-controller="Methodist"
                                           asp-action="Details"
                                           asp-route-id="@request.Id"
                                           class="office-btn office-btn-outline">
                                        Открыть
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>