@model EduDocFlow.Web.ViewModels.MethodistDashboardViewModel
@using EduDocFlow.Web.Models

@{
    ViewData["Title"] = "Кабинет методиста";

    string StatusName(DocumentStatus status)
    {
        return status switch
        {
            DocumentStatus.Created => "Создана",
            DocumentStatus.OnMethodistReview => "В работе у учебной части",
            DocumentStatus.Completed => "Готова",
            DocumentStatus.Rejected => "Отклонена",
            _ => "Неизвестный статус"
        };
    }

    string StatusBadgeClass(DocumentStatus status)
    {
        return status switch
        {
            DocumentStatus.Created => "bg-secondary",
            DocumentStatus.OnMethodistReview => "bg-warning text-dark",
            DocumentStatus.Completed => "bg-success",
            DocumentStatus.Rejected => "bg-danger",
            _ => "bg-secondary"
        };
    }

    string EmptyText(string value)
    {
        return string.IsNullOrWhiteSpace(value) ? "Не указано" : value;
    }

    var hasFilters = !string.IsNullOrWhiteSpace(Model.SearchQuery) || Model.SelectedStatus.HasValue;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <h1 class="mb-1">Кабинет методиста</h1>
            <p class="text-muted mb-0">
                Обработка заявок студентов на оформление учебных документов
            </p>
        </div>

        <div class="text-end">
            <div class="text-muted small">Пользователь</div>
            <div class="fw-semibold">@Model.FullName</div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    <div class="row g-3 mb-4">
        <div class="col-md-2">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="text-muted small">Всего заявок</div>
                    <div class="fs-3 fw-semibold">@Model.TotalRequests</div>
                </div>
            </div>
        </div>

        <div class="col-md-2">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="text-muted small">Создана</div>
                    <div class="fs-3 fw-semibold">@Model.CreatedRequests</div>
                </div>
            </div>
        </div>

        <div class="col-md-2">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="text-muted small">На проверке</div>
                </div>
            </div>
        </div>

        <div class="col-md-2">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="text-muted small">В работе</div>
                    <div class="fs-3 fw-semibold">@Model.MethodistReviewRequests</div>
                </div>
            </div>
        </div>

        <div class="col-md-2">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="text-muted small">Готова</div>
                    <div class="fs-3 fw-semibold">@Model.CompletedRequests</div>
                </div>
            </div>
        </div>

        <div class="col-md-2">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="text-muted small">Отклонена</div>
                    <div class="fs-3 fw-semibold">@Model.RejectedRequests</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white">
            <h5 class="mb-0">Поиск и фильтр заявок</h5>
        </div>

        <div class="card-body">
            <form asp-controller="Methodist" asp-action="Index" method="get" class="row g-3 align-items-end">
                <div class="col-md-6">
                    <label class="form-label">Поиск</label>
                    <input type="text"
                           name="search"
                           value="@Model.SearchQuery"
                           class="form-control"
                           placeholder="Номер заявки, ФИО студента, почта, группа или тип документа" />
                </div>

                <div class="col-md-3">
                    <label class="form-label">Статус</label>
                    <select name="status" class="form-select">
                        <option value="">Все статусы</option>

                        <option value="@DocumentStatus.Created"
                                selected="@(Model.SelectedStatus == DocumentStatus.Created ? "selected" : null)">
                            Создана
                        </option>

                        <option value="@DocumentStatus.OnMethodistReview"
                                selected="@(Model.SelectedStatus == DocumentStatus.OnMethodistReview ? "selected" : null)">
                            В работе у учебной части
                        </option>

                        <option value="@DocumentStatus.Completed"
                                selected="@(Model.SelectedStatus == DocumentStatus.Completed ? "selected" : null)">
                            Готова
                        </option>

                        <option value="@DocumentStatus.Rejected"
                                selected="@(Model.SelectedStatus == DocumentStatus.Rejected ? "selected" : null)">
                            Отклонена
                        </option>
                    </select>
                </div>

                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-fill">
                        Применить
                    </button>

                    @if (hasFilters)
                    {
                        <a asp-controller="Methodist"
                           asp-action="Index"
                           class="btn btn-outline-secondary">
                            Сбросить
                        </a>
                    }
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Заявки студентов</h5>
            <span class="text-muted small">
                Показано @Model.Requests.Count из @Model.FilteredRequestsCount
            </span>
        </div>

        <div class="card-body p-0">
            @if (!Model.Requests.Any())
            {
                <div class="p-4 text-muted">
                    По заданным условиям заявки не найдены.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>№</th>
                                <th>Номер заявки</th>
                                <th>Студент</th>
                                <th>Группа</th>
                                <th>Тип документа</th>
                                <th>Дата создания</th>
                                <th>Срок исполнения</th>
                                <th>Статус</th>
                                <th class="text-end">Действия</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var request in Model.Requests)
                            {
                                <tr>
                                    <td>@request.Id</td>
                                    <td>@request.Number</td>
                                    <td>@request.StudentFullName</td>
                                    <td>@EmptyText(request.StudentGroup)</td>
                                    <td>@request.DocumentTypeName</td>
                                    <td>@request.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                    <td>
                                        @(request.DueDate.HasValue
                                            ? request.DueDate.Value.ToString("dd.MM.yyyy")
                                            : "Не указан")
                                    </td>
                                    <td>
                                        <span class="badge @StatusBadgeClass(request.Status)">
                                            @StatusName(request.Status)
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <a asp-controller="Methodist"
                                           asp-action="Details"
                                           asp-route-id="@request.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            Открыть
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>