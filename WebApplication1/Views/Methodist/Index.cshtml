@functions {
    string RoleName(object? role)
    {
        var value = role?.ToString() ?? "";

        return value switch
        {
            "Student" => "Студент",
            "Methodist" => "Сотрудник",
            "Administrator" => "Администратор",
            "Admin" => "Администратор",
            _ => value
        };
    }

    string DisplayName(object? value)
    {
        var text = value?.ToString() ?? "";

        return text switch
        {
            "Certificate" => "Справка",
            "Application" => "Заявление",
            "Service" => "Служебный документ",
            "ServiceDocument" => "Служебный документ",
            _ => text
        };
    }

    string StatusBadgeClass(bool isActive)
    {
        return isActive
            ? "bg-success-subtle text-success"
            : "bg-secondary-subtle text-secondary";
    }

    string StatusText(bool isActive)
    {
        return isActive ? "Активен" : "Выключен";
    }
}

<style>
    .admin-dashboard-container {
        max-width: 1600px;
    }

    .admin-dashboard-grid {
        display: grid;
        grid-template-columns: minmax(520px, 0.9fr) minmax(760px, 1.35fr);
        gap: 1.5rem;
        align-items: stretch;
    }

    .admin-table th {
        font-size: 0.78rem;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        color: #1f2937;
        white-space: nowrap;
    }

    .admin-table td {
        vertical-align: middle;
    }

    .admin-doc-name {
        min-width: 260px;
    }

    .admin-doc-category {
        width: 150px;
        white-space: nowrap;
    }

    .admin-doc-status {
        width: 130px;
        white-space: nowrap;
    }

    .admin-doc-actions {
        width: 190px;
        white-space: nowrap;
    }

    .admin-user-actions {
        width: 190px;
        white-space: nowrap;
    }

    .admin-actions-wrap {
        display: inline-flex;
        justify-content: flex-end;
        gap: 0.5rem;
        flex-wrap: nowrap;
    }

    @@media (max-width: 1399.98px) {
        .admin-dashboard-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="admin-dashboard-grid">
    <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden">
        <div class="card-header bg-white border-bottom d-flex flex-column flex-md-row justify-content-between gap-3 align-items-md-center p-4">
            <div>
                <h2 class="h5 mb-1 fw-bold">Пользователи</h2>
                <div class="text-muted small">Последние учетные записи в системе</div>
            </div>

            <a asp-controller="Admin"
                   asp-action="CreateUser"
                   class="btn btn-primary">
                Добавить пользователя
            </a>
        </div>

        <div class="card-body p-0">
            @if (!Model.RecentUsers.Any())
            {
                <div class="p-4 text-muted">
                    Пользователей пока нет.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 admin-table">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Почта</th>
                                <th>Роль</th>
                                <th>Статус</th>
                                <th class="text-end pe-4 admin-user-actions">Действия</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var user in Model.RecentUsers)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-semibold">@user.FullName</div>
                                        <div class="text-muted small">@user.Email</div>
                                    </td>

                                    <td>@RoleName(user.Role)</td>

                                    <td>
                                        <span class="badge rounded-pill px-3 py-2 @StatusBadgeClass(user.IsActive)">
                                            @StatusText(user.IsActive)
                                        </span>
                                    </td>

                                    <td class="text-end pe-4 admin-user-actions">
                                        @if (user.Id == Model.CurrentUserId)
                                        {
                                            <span class="text-muted small">Текущий пользователь</span>
                                        }
                                        else
                                        {
                                            <div class="admin-actions-wrap">
                                                <a asp-controller="Admin"
                                                       asp-action="EditUser"
                                                       asp-route-id="@user.Id"
                                                       class="btn btn-sm btn-outline-primary">
                                                    Изменить
                                                </a>

                                                <form asp-controller="Admin"
                                                      asp-action="ToggleUserActive"
                                                      method="post"
                                                      class="d-inline">
                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden" name="id" value="@user.Id" />

                                                    <button type="submit"
                                                            class="btn btn-sm @(user.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                                                        @(user.IsActive ? "Отключить" : "Включить")
                                                    </button>
                                                </form>
                                            </div>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden">
        <div class="card-header bg-white border-bottom d-flex flex-column flex-md-row justify-content-between gap-3 align-items-md-center p-4">
            <div>
                <h2 class="h5 mb-1 fw-bold">Типы документов</h2>
                <div class="text-muted small">Справки и заявления, доступные студентам</div>
            </div>

            <a asp-controller="Admin"
                   asp-action="CreateDocumentType"
                   class="btn btn-primary">
                Добавить тип
            </a>
        </div>

        <div class="card-body p-0">
            @if (!Model.DocumentTypes.Any())
            {
                <div class="p-4 text-muted">
                    Типы документов пока не добавлены.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 admin-table">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4 admin-doc-name">Наименование</th>
                                <th class="admin-doc-category">Категория</th>
                                <th class="admin-doc-status">Статус</th>
                                <th class="text-end pe-4 admin-doc-actions">Действия</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model.DocumentTypes)
                            {
                                <tr>
                                    <td class="ps-4 admin-doc-name">
                                        <div class="fw-semibold">@item.Name</div>
                                        <div class="text-muted small">@item.Code</div>
                                    </td>

                                    <td class="admin-doc-category">
                                        @DisplayName(item.Category)
                                    </td>

                                    <td class="admin-doc-status">
                                        <span class="badge rounded-pill px-3 py-2 @StatusBadgeClass(item.IsActive)">
                                            @StatusText(item.IsActive)
                                        </span>
                                    </td>

                                    <td class="text-end pe-4 admin-doc-actions">
                                        <div class="admin-actions-wrap">
                                            <a asp-controller="Admin"
                                                   asp-action="EditDocumentType"
                                                   asp-route-id="@item.Id"
                                                   class="btn btn-sm btn-outline-primary">
                                                Изменить
                                            </a>

                                            <form asp-controller="Admin"
                                                  asp-action="ToggleDocumentTypeActive"
                                                  asp-route-id="@item.Id"
                                                  method="post"
                                                  class="d-inline">
                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm @(item.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                                                    @(item.IsActive ? "Отключить" : "Включить")
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>