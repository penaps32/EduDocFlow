@model EduDocFlow.Web.ViewModels.UserFormViewModel
@using EduDocFlow.Web.Models

@{
    var isCreateMode = Model.Id == 0;
    ViewData["Title"] = isCreateMode ? "Добавление пользователя" : "Редактирование пользователя";
}

<div class="container admin-dashboard-container admin-form-container py-5">
    <div class="admin-page-head d-flex flex-column flex-lg-row justify-content-between gap-4 align-items-lg-end mb-4">
        <div>
            <div class="text-muted text-uppercase fw-semibold small mb-2">Администрирование</div>
            <h1 class="mb-2 fw-bold">@(isCreateMode ? "Добавление пользователя" : "Редактирование пользователя")</h1>
            <p class="text-muted mb-0">
                Создание и настройка учетной записи пользователя системы.
            </p>
        </div>

        <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary admin-back-btn">
            Назад в панель администратора
        </a>
    </div>

    <div class="row g-4 align-items-start">
        <div class="col-12 col-xl-8">
            <div class="card shadow-sm border-0 rounded-4 admin-form-card">
                <div class="card-header bg-white admin-card-header rounded-top-4">
                    <div>
                        <h5 class="mb-1 fw-bold">Данные пользователя</h5>
                        <div class="text-muted small">
                            Заполните основные данные, роль и статус учетной записи.
                        </div>
                    </div>
                </div>

                <div class="card-body admin-form-body">
                    <form asp-controller="Admin" asp-action="SaveUser" method="post">
                        @Html.AntiForgeryToken()

                        <input type="hidden" asp-for="Id" />

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="FullName" class="form-label"></label>
                                <input asp-for="FullName" class="form-control admin-input" placeholder="Например: Иванов Иван Иванович" />
                                <span asp-validation-for="FullName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label"></label>
                                <input asp-for="Email" class="form-control admin-input" placeholder="Например: student@edudoc.local" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="Password" class="form-label"></label>
                                <input asp-for="Password"
                                       type="password"
                                       class="form-control admin-input"
                                       placeholder="@(isCreateMode ? "Пароль обязателен" : "Не заполняйте без смены")" />
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="Role" class="form-label"></label>
                                <select asp-for="Role" class="form-select admin-input">
                                    <option value="@UserRole.Student">Студент</option>
                                    <option value="@UserRole.Methodist">Сотрудник</option>
                                    <option value="@UserRole.Admin">Администратор</option>
                                </select>
                                <span asp-validation-for="Role" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4 d-flex align-items-end">
                                <div class="admin-check-box w-100">
                                    <div class="form-check mb-0">
                                        <input asp-for="IsActive" class="form-check-input" />
                                        <label asp-for="IsActive" class="form-check-label"></label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div id="studentProfileBlock" class="admin-student-profile">
                            <div class="admin-section-divider"></div>

                            <div class="d-flex flex-column flex-md-row justify-content-between gap-2 mb-3">
                                <div>
                                    <h5 class="mb-1 fw-bold">Данные студента</h5>
                                    <div class="text-muted small">
                                        Эти сведения используются при формировании справок и заявлений студента.
                                    </div>
                                </div>
                            </div>

                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label asp-for="StudentCode" class="form-label"></label>
                                    <input asp-for="StudentCode" class="form-control admin-input" />
                                    <span asp-validation-for="StudentCode" class="text-danger small"></span>
                                </div>

                                <div class="col-md-4">
                                    <label asp-for="GroupName" class="form-label"></label>
                                    <input asp-for="GroupName" class="form-control admin-input" placeholder="Например: ИСП-401" />
                                    <span asp-validation-for="GroupName" class="text-danger small"></span>
                                </div>

                                <div class="col-md-4">
                                    <label asp-for="Course" class="form-label"></label>
                                    <input asp-for="Course" type="number" class="form-control admin-input" />
                                    <span asp-validation-for="Course" class="text-danger small"></span>
                                </div>

                                <div class="col-md-8">
                                    <label asp-for="EducationProgram" class="form-label"></label>
                                    <input asp-for="EducationProgram"
                                           class="form-control admin-input"
                                           placeholder="Например: Информационные системы и программирование" />
                                    <span asp-validation-for="EducationProgram" class="text-danger small"></span>
                                </div>

                                <div class="col-md-4">
                                    <label asp-for="StudyForm" class="form-label"></label>
                                    <input asp-for="StudyForm" class="form-control admin-input" placeholder="Например: очная" />
                                    <span asp-validation-for="StudyForm" class="text-danger small"></span>
                                </div>

                                <div class="col-md-4">
                                    <label asp-for="EnrollmentDate" class="form-label"></label>
                                    <input asp-for="EnrollmentDate" type="date" class="form-control admin-input" />
                                    <span asp-validation-for="EnrollmentDate" class="text-danger small"></span>
                                </div>

                                <div class="col-md-4">
                                    <label asp-for="StudentStatus" class="form-label"></label>
                                    <input asp-for="StudentStatus" class="form-control admin-input" placeholder="Например: обучается" />
                                    <span asp-validation-for="StudentStatus" class="text-danger small"></span>
                                </div>

                                <div class="col-md-4 d-flex align-items-end">
                                    <div class="admin-check-box w-100">
                                        <div class="form-check mb-0">
                                            <input asp-for="IsDormitoryResident" class="form-check-input" />
                                            <label asp-for="IsDormitoryResident" class="form-check-label"></label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="admin-form-actions d-flex flex-column flex-sm-row justify-content-end gap-2 mt-4">
                            <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary">
                                Отмена
                            </a>

                            <button type="submit" class="btn btn-primary">
                                Сохранить пользователя
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-4">
            <div class="card shadow-sm border-0 rounded-4 admin-side-card mb-4">
                <div class="card-body">
                    <h5 class="fw-bold mb-3">Роли в системе</h5>

                    <div class="admin-role-note mb-3">
                        <div class="admin-role-number bg-primary-subtle text-primary">01</div>
                        <div>
                            <div class="fw-semibold">Студент</div>
                            <div class="text-muted small">Подает заявки, отслеживает статусы и получает готовые документы.</div>
                        </div>
                    </div>
                    <div class="admin-role-note mb-3">
                        <div class="admin-role-number bg-success-subtle text-success">02</div>
                        <div>
                            <div class="fw-semibold">Сотрудник</div>
                            <div class="text-muted small">Проверяет заявки, меняет статусы и формирует документы.</div>
                        </div>
                    </div>

                    <div class="admin-role-note">
                        <div class="admin-role-number bg-secondary-subtle text-secondary">03</div>
                        <div>
                            <div class="fw-semibold">Администратор</div>
                            <div class="text-muted small">Управляет пользователями и типами документов.</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm border-0 rounded-4 admin-side-card">
                <div class="card-body">
                    <h5 class="fw-bold mb-2">Пароль</h5>
                    <p class="text-muted mb-0">
                        При добавлении нового пользователя пароль обязателен. При редактировании оставьте поле пустым, если пароль менять не нужно.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function updateStudentProfileBlockVisibility() {
            const roleSelect = document.getElementById("Role");
            const studentProfileBlock = document.getElementById("studentProfileBlock");

            if (!roleSelect || !studentProfileBlock) {
                return;
            }

            const selectedRole = roleSelect.value;
            const isStudent = selectedRole === "@UserRole.Student";

            studentProfileBlock.style.display = isStudent ? "block" : "none";

            const fields = studentProfileBlock.querySelectorAll("input, select, textarea");

            fields.forEach(field => {
                field.disabled = !isStudent;
            });
        }

        document.addEventListener("DOMContentLoaded", updateStudentProfileBlockVisibility);

        const roleSelect = document.getElementById("Role");

        if (roleSelect) {
            roleSelect.addEventListener("change", updateStudentProfileBlockVisibility);
        }
    </script>
}
