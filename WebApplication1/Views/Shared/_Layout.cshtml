@using EduDocFlow.Web.Models

@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

    var isLoginPage = currentController == "Account" && currentAction == "Login";
    var isAuthenticated = User.Identity?.IsAuthenticated == true;

    var userName = User.Identity?.Name ?? "";

    var sectionName = "Учебный документооборот";
    var roleName = "";

    if (User.IsInRole(nameof(UserRole.Admin)))
    {
        sectionName = "Панель администратора";
        roleName = "Администратор";
    }
    else if (User.IsInRole(nameof(UserRole.Methodist)))
    {
        sectionName = "Кабинет сотрудника";
        roleName = "Сотрудник";
    }
    else if (User.IsInRole(nameof(UserRole.Student)))
    {
        sectionName = "Кабинет студента";
        roleName = "Студент";
    }
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Учебный документооборот</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EduDocFlow.Web.styles.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body class="@(isLoginPage ? "auth-body" : "portal-body")">
    @if (isLoginPage)
    {
        <main>
            @RenderBody()
        </main>
    }
    else
    {
        <div class="portal-shell no-sidebar">
            <div class="portal-main">
                <header class="portal-topbar">

                    <div class="portal-topbar-center">
                        @if (isAuthenticated && !(ViewData["HideUserPanel"] as bool? == true))
                        {
                            <div class="portal-user">
                                <div class="portal-user-info">
                                    <div class="portal-user-role">@roleName</div>
                                    <div class="portal-user-name">@userName</div>
                                </div>

                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-secondary btn-sm">Выйти</button>
                                </form>
                            </div>
                        }
                        else
                        {
                            <div class="portal-user-empty"></div>
                        }
                </header>

                <main class="portal-content">
                    @RenderBody()
                </main>
            </div>
        </div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>