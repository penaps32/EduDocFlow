<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Учебный документооборот</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/core@latest/dist/css/tabler.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WebApplication1.styles.css" asp-append-version="true" />
</head>

<body>
    <div class="page">
        <header class="navbar navbar-expand-md d-print-none edf-navbar">
            <div class="container-xl">
                <a class="navbar-brand edf-brand" asp-controller="Home" asp-action="Index">
                    <span class="edf-brand-mark">УД</span>
                    <span>Учебный документооборот</span>
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Переключить навигацию">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div id="mainNavbar" class="collapse navbar-collapse">
                    <ul class="navbar-nav">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            if (User.IsInRole("Student"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Student" asp-action="Index">
                                        Кабинет студента
                                    </a>
                                </li>
                            }

                            if (User.IsInRole("Methodist"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Methodist" asp-action="Index">
                                        Кабинет сотрудника
                                    </a>
                                </li>
                            }

                            if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Admin" asp-action="Index">
                                        Панель администратора
                                    </a>
                                </li>
                            }
                        }
                    </ul>

                    <div class="ms-auto d-flex align-items-center gap-3">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <div class="d-none d-md-block text-end">
                                <div class="small text-secondary">Пользователь</div>
                                <div class="fw-semibold">@User.Identity.Name</div>
                            </div>

                            <form asp-controller="Account"
                                  asp-action="Logout"
                                  method="post"
                                  class="d-inline">
                                @Html.AntiForgeryToken()

                                <button type="submit" class="btn btn-outline-secondary">
                                    Выйти
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        </header>

        <main class="page-wrapper">
            <div class="page-body">
                @RenderBody()
            </div>
        </main>

        <footer class="footer footer-transparent d-print-none">
            <div class="container-xl">
                <div class="text-secondary">
                    © 2026 - Учебный документооборот - информационная система обработки заявлений и справок студентов
                </div>
            </div>
        </footer>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/@@tabler/core@latest/dist/js/tabler.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>